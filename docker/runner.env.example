# The runner's settings on the Docker host: copy to ~/.config/valet/runner.env and `chmod 600` it
# (docker/valet-runner.service reads it). Never commit the filled-in file.

# The control plane in Docker on this host (docker/compose.yml publishes 127.0.0.1:8780).
VALET_CONTROL_URL=ws://127.0.0.1:8780/ws/runner
# From `docker exec -it <control container> valet-control add-runner myhost` (shown once).
VALET_RUNNER_TOKEN=
# Host agents' own working folders and every agent's compiled config.
VALET_RUNNER_DATA=/home/you/.local/share/valet-runner
# Container agents' default image (built on this host: docker build -t valet/agent-base docker/agent-base).
VALET_AGENT_IMAGE=valet/agent-base

# Harness keys, passed to each harness's agents only.
CLAUDE_CODE_OAUTH_TOKEN=
DEEPSEEK_API_KEY=
